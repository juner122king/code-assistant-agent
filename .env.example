# LLM：硅基流动（OpenAI 兼容）。勿提交真实密钥。
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-8B
# Qwen3 等默认可能开 thinking，Agent 工具循环请保持 false
LLM_ENABLE_THINKING=false

# 备选免费模型：Qwen/Qwen2.5-7B-Instruct  THUDM/GLM-4-9B-0414  Qwen/Qwen3.5-4B

# 旧 Anthropic 兼容中转（LLM_PROVIDER=anthropic 时生效）
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=http://47.98.155.122:8000
ANTHROPIC_MODEL=grok-4.5
# 中转站：直连 + 重试 + 步间限速（Agent 连发比单次对话更易触发上游限流）
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_SECONDS=2
LLM_TRUST_ENV_PROXY=false
# 硅基流动保持 0；旧 Anthropic 中转可设 2.5 防限流
LLM_STEP_DELAY_SECONDS=0
AGENT_MAX_TOKENS=4096
AGENT_TOOL_MAX_TOKENS=1024

# GitHub API（可选：提高 rate limit / 访问私有仓库）
GITHUB_TOKEN=

# Agent 护栏
AGENT_MAX_STEPS=8
AGENT_MAX_STEPS_CAP=40
AGENT_MAX_FILE_BYTES=30000
AGENT_MAX_TREE_ENTRIES=200
AGENT_MAX_TOKENS=8192

# 修复提案（/fix/*）
ANALYZE_HISTORY_MAX=50

FIX_PROPOSAL_TTL_SECONDS=1800
FIX_MAX_STEPS=10
FIX_MAX_FILES=8

# 服务
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
