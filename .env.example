# Anthropic 兼容 API（支持官方 / 中转站）
# 官方：只填 ANTHROPIC_API_KEY，BASE_URL 留空
# 中转：填 ANTHROPIC_AUTH_TOKEN（或 API_KEY）+ ANTHROPIC_BASE_URL + 模型名
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5

# GitHub API（可选：提高 rate limit / 访问私有仓库）
GITHUB_TOKEN=

# Agent 护栏
AGENT_MAX_STEPS=12
AGENT_MAX_FILE_BYTES=30000
AGENT_MAX_TREE_ENTRIES=200
AGENT_MAX_TOKENS=8192

# 服务
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
